# ============================================================
# IT OPERATIONS HOMELAB — SECURITY-FOCUSED .gitignore
# ============================================================

# ------------------------------------------------------------
# 1. PRIVATE / LOCAL-ONLY DIRECTORIES
# Store all unsanitised exports and sensitive evidence here.
# ------------------------------------------------------------

**/Private/
**/private/
**/Sensitive/
**/sensitive/
**/Raw/
**/raw/
**/Raw-Exports/
**/raw-exports/
**/Local-Only/
**/local-only/

# ------------------------------------------------------------
# 2. CREDENTIALS, SECRETS, TOKENS, AND ENVIRONMENT FILES
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template

*.secret
*.secrets
*.token
*.tokens
*.credential
*.credentials

secrets.json
secret.json
credentials.json
credential.json
auth.json
authentication.json

*secret*.json
*credential*.json
*token*.json

# Common API and application secret files
appsettings.*.json
local.settings.json
service-account*.json
serviceaccount*.json

# ------------------------------------------------------------
# 3. PRIVATE KEYS, CERTIFICATES, AND KEYSTORES
# ------------------------------------------------------------

*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.kdbx
*.ppk

# Public certificates may not contain private keys, but are
# excluded by default to avoid publishing tenant information.
*.cer
*.crt
*.der

# SSH keys and configuration
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
known_hosts
authorized_keys

# ------------------------------------------------------------
# 4. MICROSOFT / AZURE / ENTRA AUTHENTICATION ARTIFACTS
# ------------------------------------------------------------

.azure/
**/.azure/
.azcopy/
**/.azcopy/

*access-token*
*access_token*
*refresh-token*
*refresh_token*
*device-code*
*device_code*
*recovery-code*
*recovery_code*

# Microsoft Graph authentication exports
*GraphContext*
*Graph-Context*
*MgContext*
*AuthenticationContext*

# ------------------------------------------------------------
# 5. MICROSOFT ENTRA RAW EXPORTS
# ------------------------------------------------------------

**/Reports/Entra-Audit-Logs.csv
**/Reports/Entra-Sign-In-Logs.csv
**/Reports/Entra-Tenant-Inventory.csv
**/Reports/Entra-User-Inventory.csv
**/Reports/Entra-Group-Inventory.csv
**/Reports/Entra-Group-Membership.csv
**/Reports/Entra-Configuration-Validation.csv

# Future Entra raw exports
**/Reports/*Audit*Logs*.csv
**/Reports/*Sign-In*Logs*.csv
**/Reports/*Signin*Logs*.csv
**/Reports/*Tenant*Inventory*.csv
**/Reports/*User*Inventory*.csv
**/Reports/*Group*Inventory*.csv
**/Reports/*Membership*.csv
**/Reports/*Authentication*.csv
**/Reports/*Identity*Export*.csv

# ------------------------------------------------------------
# 6. GENERAL RAW LOGS, EXPORTS, AND OPERATIONAL DATA
# ------------------------------------------------------------

# Raw log formats
*.evtx
*.etl
*.dmp
*.dump
*.pcap
*.pcapng
*.cap

# Generic logs
*.log
logs/
**/logs/
LogFiles/
**/LogFiles/

# PowerShell transcripts
*.transcript.txt
PowerShell_transcript.*
PowerShell_transcript_*
Transcripts/
**/Transcripts/

# Raw exports from administrative tools
**/Exports/
**/exports/
**/RawData/
**/raw-data/

# ------------------------------------------------------------
# 7. WINDOWS AND ACTIVE DIRECTORY SENSITIVE EXPORTS
# ------------------------------------------------------------

# Registry exports
*.reg

# Group Policy backups and reports
**/GroupPolicyBackup/
**/GPO-Backups/
**/GPOBackups/

# Active Directory database and system files
ntds.dit
SYSTEM
SAM
SECURITY

# Password and account exports
*password-export*
*password_export*
*credential-export*
*credential_export*
*account-export*
*account_export*

# ------------------------------------------------------------
# 8. MICROSOFT 365 AND EXCHANGE RAW EXPORTS
# ------------------------------------------------------------

*.pst
*.ost

**/Reports/*Mailbox*Export*.csv
**/Reports/*Exchange*Export*.csv
**/Reports/*MessageTrace*.csv
**/Reports/*MailFlow*.csv
**/Reports/*License*Assignment*.csv
**/Reports/*M365*Users*.csv

# ------------------------------------------------------------
# 9. SECURITY OPERATIONS RAW DATA
# ------------------------------------------------------------

**/Reports/*SecurityAlert*.csv
**/Reports/*SecurityIncident*.csv
**/Reports/*Defender*Export*.csv
**/Reports/*Sentinel*Export*.csv
**/Reports/*ThreatHunt*.csv
**/Reports/*Sysmon*Events*.csv
**/Reports/*IncidentEvidence*.csv

# Preserve sanitised portfolio reports
!**/Reports/*Sanitized*.csv
!**/Reports/*Sanitised*.csv
!**/Reports/*Public*.csv
!**/Reports/*Sample*.csv

# ------------------------------------------------------------
# 10. BACKUPS, ARCHIVES, AND DATABASES
# ------------------------------------------------------------

*.bak
*.backup
*.old
*.orig
*.save
*.sql
*.sqlite
*.sqlite3
*.db
*.mdb

*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ------------------------------------------------------------
# 11. TEMPORARY AND GENERATED FILES
# ------------------------------------------------------------

*.tmp
*.temp
*.swp
*.swo
*.cache
*.lock
*.pid

tmp/
temp/
.cache/
**/.cache/

# PowerShell module and command history
ConsoleHost_history.txt
PSReadLine/
**/PSReadLine/

# ------------------------------------------------------------
# 12. IDE AND EDITOR FILES
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json

.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------
# 13. OPERATING SYSTEM FILES
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# 14. TERRAFORM AND CLOUD INFRASTRUCTURE STATE
# ------------------------------------------------------------

.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Preserve safe examples
!*.tfvars.example
!*.tfvars.template

# ------------------------------------------------------------
# 15. ANSIBLE AND AUTOMATION SECRETS
# ------------------------------------------------------------

.vault_pass
vault-password*
vault_password*
ansible-vault-password*

# ------------------------------------------------------------
# 16. CONTAINER AND DEVELOPMENT SECRETS
# ------------------------------------------------------------

.docker/config.json
docker-compose.override.yml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

node_modules/
venv/
.venv/
__pycache__/
*.pyc

# ------------------------------------------------------------
# 17. SCREENSHOT WORKING FILES
# Keep only manually reviewed images in Evidence/Screenshots.
# ------------------------------------------------------------

**/Evidence/Unredacted/
**/Evidence/Originals/
**/Evidence/Raw/
**/Evidence/Working/
**/Screenshots/Unredacted/
**/Screenshots/Originals/

# ------------------------------------------------------------
# 18. LOCAL SECURITY SCAN RESULTS
# These can expose paths, findings, or detected secret values.
# ------------------------------------------------------------

.gitleaks-report*
gitleaks-report*
trufflehog-report*
secret-scan-report*
security-scan-results*

# ------------------------------------------------------------
# 19. LOCAL NOTES
# ------------------------------------------------------------

notes-private.md
private-notes.md
todo-private.md
LOCAL-NOTES.md
